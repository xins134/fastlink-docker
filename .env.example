# Leave empty for no password prompt. Optional password: eight printable characters.
VNC_PASSWORD=

# Use 127.0.0.1 for local-only access, or 0.0.0.0 for LAN access.
FASTLINK_BIND_ADDRESS=0.0.0.0
FASTLINK_WEB_PORT=6080
FASTLINK_PROXY_BIND_ADDRESS=0.0.0.0
FASTLINK_PROXY_PORT=7890
TZ=Asia/Shanghai
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800
# Optional container memory limit. Raise it if Fastlink is OOM-killed.
FASTLINK_MEMORY_LIMIT=1g
FASTLINK_MEMORY_RESERVATION=256m
